# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Treat notebooks as text to reduce diff noise
*.ipynb linguist-detectable=true

# Normalize common text files
*.py text
*.md text
*.txt text
*.html text
*.css text
*.js text

# If you enable Git LFS later, you can track large binaries
# *.h5 filter=lfs diff=lfs merge=lfs -text
# *.weights.h5 filter=lfs diff=lfs merge=lfs -text
